  preBattleLines:
  - speakerName: Raze
    side: 1
    text: "C\u1EADu \u0111ang t\xECm ai?"
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.85, a: 1}
    actionDescription: "[Raze t\u1EF1a t\u01B0\u1EDDng khoanh tay nh\xECn xu\u1ED1ng]"
    illustration: {fileID: 21300000, guid: 788016df251f4a2e940ac17fc2a010e6, type: 3}
  - speakerName: '{PLAYER}'
    side: 0
    text: "T\xF4i t\xECm Raze. T\xF4i mu\u1ED1n l\u1EA5y Huy hi\u1EC7u Nh\u1ECBp
      \u0111i\u1EC7u."
    customAvatar: {fileID: 21300000, guid: ff10bfe60da849879042d61c0c0ccc3e, type: 3}
    nameColor: {r: 0.2, g: 0.95, b: 1, a: 1}
    actionDescription: "[Ng\u01B0\u1EDDi ch\u01A1i ng\u1EA9ng cao \u0111\u1EA7u,
      ch\u1EC9 tay ki\xEAn \u0111\u1ECBnh]"
    illustration: {fileID: 21300000, guid: 788016df251f4a2e940ac17fc2a010e6, type: 3}
  - speakerName: Raze
    side: 1
    text: "T\xF4i l\xE0 Raze. Nh\u01B0ng mu\u1ED1n l\u1EA5y huy hi\u1EC7u th\xEC
      c\u1EADu ph\u1EA3i th\u1EAFng t\xF4i."
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.85, a: 1}
    actionDescription: "[Raze l\u1EAFc b\xECnh s\u01A1n, ch\u1EC9 ng\xF3n c\xE1i
      ng\u1EA1o ngh\u1EC5]"
    illustration: {fileID: 21300000, guid: 0c902bf420f54b789fe1475cb209a63b, type: 3}
  - speakerName: '{PLAYER}'
    side: 0
    text: "T\xF4i bi\u1EBFt."
    customAvatar: {fileID: 21300000, guid: ff10bfe60da849879042d61c0c0ccc3e, type: 3}
    nameColor: {r: 0.2, g: 0.95, b: 1, a: 1}
    actionDescription: "[Ng\u01B0\u1EDDi ch\u01A1i si\u1EBFt ch\u1EB7t n\u1EAFm \u0111\u1EA5m
      t\u1EF1 tin]"
    illustration: {fileID: 21300000, guid: 0c902bf420f54b789fe1475cb209a63b, type: 3}
  - speakerName: Raze
    side: 1
    text: "T\xE2n binh m\xE0 gan \u0111\u1EA5y. L\xEAn s\xE2n kh\u1EA5u \u0111i."
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.85, a: 1}
    actionDescription: "[Raze ch\u1EC9 b\xECnh s\u01A1n ra gi\u1EEFa s\xE0n \u0111\u1EA5u]"
    illustration: {fileID: 21300000, guid: b4c4e258280645869d74d650036bcaea, type: 3}
  - speakerName: '{PLAYER}'
    side: 0
    text: "B\u1EAFt \u0111\u1EA7u th\xF4i."
    customAvatar: {fileID: 21300000, guid: ff10bfe60da849879042d61c0c0ccc3e, type: 3}
    nameColor: {r: 0.2, g: 0.95, b: 1, a: 1}
    actionDescription: "[Ng\u01B0\u1EDDi ch\u01A1i v\xE0o th\u1EBF nh\u1EA3y r\u1EF1c
      l\u1EEDa]"
    illustration: {fileID: 21300000, guid: b4c4e258280645869d74d650036bcaea, type: 3}
  postBattleLines:
  - speakerName: Raze
    side: 1
    text: "Kh\xF4ng t\u1EC7. C\u1EADu th\u1EAFng r\u1ED3i."
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.85, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: '{PLAYER}'
    side: 0
    text: "V\u1EADy huy hi\u1EC7u thu\u1ED9c v\u1EC1 t\xF4i?"
    customAvatar: {fileID: 21300000, guid: ff10bfe60da849879042d61c0c0ccc3e, type: 3}
    nameColor: {r: 0.2, g: 0.95, b: 1, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: Raze
    side: 1
    text: "Ph\u1EA3i. C\u1EA7m l\u1EA5y v\xE0 \u0111\u1EEBng \u0111\u1EC3 thua Nox."
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.85, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: '{PLAYER}'
    side: 0
    text: "Anh \u0111ang c\u1ED5 v\u0169 t\xF4i sao?"
    customAvatar: {fileID: 21300000, guid: ff10bfe60da849879042d61c0c0ccc3e, type: 3}
    nameColor: {r: 0.2, g: 0.95, b: 1, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: Raze
    side: 1
    text: "T\xF4i ch\u1EC9 kh\xF4ng mu\u1ED1n m\xECnh thua m\u1ED9t k\u1EBB y\u1EBFu."
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.85, a: 1}
