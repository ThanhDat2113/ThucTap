  m_Name: Chapter1_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::Luan.Dialogue.DialogueStoryData
  chapterNumber: 1
  chapterTitle: 'Chapter 1: Concrete Dreams'
  introVideoClip: {fileID: 32900000, guid: 6a543ca091acda94abab403056e56f21, type: 3}
  introVideoDuration: 8
  backstoryImages:
  - {fileID: -8837768905556238398, guid: 751de15cfeea84b4f9d1e5c6e318db35, type: 3}
  - {fileID: -7662263399865843508, guid: 168aec92f3a04a54fa6590f8c654545b, type: 3}
  - {fileID: 238752463935767950, guid: 7659ec344f52d3c4da8e1d47257f9a9c, type: 3}
  - {fileID: 705135154753200828, guid: fe0861580bb954c46b39ae3525ad3722, type: 3}
  winDialogueLines:
  - speakerName: Raze
    side: 1
    text: "Kh\xF4ng t\u1EC7. C\u1EADu th\u1EAFng r\u1ED3i."
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.85, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: '{PLAYER}'
    side: 0
    text: "V\u1EADy huy hi\u1EC7u thu\u1ED9c v\u1EC1 t\xF4i?"
    customAvatar: {fileID: 21300000, guid: ff10bfe60da849879042d61c0c0ccc3e, type: 3}
    nameColor: {r: 0.2, g: 0.95, b: 1, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: Raze
    side: 1
    text: "Ph\u1EA3i. C\u1EA7m l\u1EA5y v\xE0 \u0111\u1EEBng \u0111\u1EC3 thua Nox."
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.85, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: '{PLAYER}'
    side: 0
    text: "Anh \u0111ang c\u1ED5 v\u0169 t\xF4i sao?"
    customAvatar: {fileID: 21300000, guid: ff10bfe60da849879042d61c0c0ccc3e, type: 3}
    nameColor: {r: 0.2, g: 0.95, b: 1, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: Raze
    side: 1
    text: "T\xF4i ch\u1EC9 kh\xF4ng mu\u1ED1n m\xECnh thua m\u1ED9t k\u1EBB y\u1EBFu."
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.85, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: '{PLAYER}'
    side: 0
    text: "T\xF4i s\u1EBD nh\u1EDB c\xE2u \u0111\xF3."
    customAvatar: {fileID: 21300000, guid: ff10bfe60da849879042d61c0c0ccc3e, type: 3}
    nameColor: {r: 0.2, g: 0.95, b: 1, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  loseDialogueLines:
  - speakerName: Raze
    side: 1
    text: "C\u1EADu c\xF3 kh\u1EA3 n\u0103ng, nh\u01B0ng v\u1EABn nh\xECn xu\u1ED1ng
      ch\xE2n qu\xE1 nhi\u1EC1u."
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.85, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: '{PLAYER}'
    side: 0
    text: "T\xF4i \u0111\xE3 m\u1EA5t nh\u1ECBp v\xEC qu\xE1 c\u0103ng th\u1EB3ng."
    customAvatar: {fileID: 21300000, guid: ff10bfe60da849879042d61c0c0ccc3e, type: 3}
    nameColor: {r: 0.2, g: 0.95, b: 1, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: Raze
    side: 1
    text: "V\u1EADy th\xEC t\u1EADp ki\u1EC3m so\xE1t n\xF3 r\u1ED3i quay l\u1EA1i."
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.85, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: '{PLAYER}'
    side: 0
    text: " Anh v\u1EABn cho t\xF4i \u0111\u1EA5u l\u1EA1i sao?"
    customAvatar: {fileID: 21300000, guid: ff10bfe60da849879042d61c0c0ccc3e, type: 3}
    nameColor: {r: 0.2, g: 0.95, b: 1, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: Raze
    side: 1
    text: " Anh v\u1EABn cho t\xF4i \u0111\u1EA5u l\u1EA1i sao?"
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.8509804, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: '{PLAYER}'
    side: 0
    text: "Anh v\u1EABn cho t\xF4i \u0111\u1EA5u l\u1EA1i sao?"
    customAvatar: {fileID: 21300000, guid: ff10bfe60da849879042d61c0c0ccc3e, type: 3}
    nameColor: {r: 0.2, g: 0.9490196, b: 1, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: Raze
    side: 1
    text: "T\xF4i \u0111\xE2u mu\u1ED1n th\u1EAFng m\u1ED9t ng\u01B0\u1EDDi ch\u01B0a
      ch\u01A1i h\u1EBFt s\u1EE9c."
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.8509804, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  - speakerName: '{PLAYER}'
    side: 0
    text: "L\u1EA7n sau t\xF4i s\u1EBD kh\xF4ng \u0111\u1EC3 anh th\u1EAFng d\u1EC5
      v\u1EADy \u0111\xE2u."
    customAvatar: {fileID: 21300000, guid: ff10bfe60da849879042d61c0c0ccc3e, type: 3}
    nameColor: {r: 0.2, g: 0.9490196, b: 1, a: 1}
    actionDescription: 
    illustration: {fileID: 0}
  chapterLogo: {fileID: -2930057027171513213, guid: f363364938986ce4595b8b3ae6390bed, type: 3}
  characterStoryTitle: "C\xE2u chuy\u1EC7n c\u1EE7a Raze"
  characterStory: "Raze l\u1EDBn l\xEAn t\u1EA1i khu ph\u1ED1 ph\xEDa T\xE2y. Khi
    c\xF2n nh\u1ECF, anh th\u01B0\u1EDDng b\u1ECB \u0111u\u1ED5i kh\u1ECFi nh\u1EEFng
    s\xE2n kh\u1EA5u l\u1EDBn v\xEC kh\xF4ng \u0111\u01B0\u1EE3c \u0111\xE0o t\u1EA1o
    b\xE0i b\u1EA3n.\n\nRaze c\xF9ng nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n bi\u1EBFn
    m\u1ED9t qu\u1EA3ng tr\u01B0\u1EDDng b\u1ECF hoang th\xE0nh n\u01A1i bi\u1EC3u
    di\u1EC5n. Anh ph\u1EE7 k\xEDn c\xE1c b\u1EE9c t\u01B0\u1EDDng b\u1EB1ng graffiti,
    t\u1ED5 ch\u1EE9c nh\u1EEFng cu\u1ED9c dance battle v\xE0 d\u1EA7n khi\u1EBFn
    khu v\u1EF1c n\xE0y tr\u1EDF n\xEAn n\u1ED5i ti\u1EBFng.\n\nSau nhi\u1EC1u n\u0103m,
    Raze tr\u1EDF th\xE0nh nh\xE0 v\xF4 \u0111\u1ECBch c\u1EE7a khu ph\u1ED1. Bi\u1EC3u
    t\u01B0\u1EE3ng v\u01B0\u01A1ng mi\u1EC7n tr\xEAn trang ph\u1EE5c l\xE0 l\u1EDDi
    nh\u1EAFc r\u1EB1ng kh\xF4ng ai \u0111\u01B0\u1EE3c ph\xE9p xem th\u01B0\u1EDDng
    anh th\xEAm l\u1EA7n n\u1EEFa. Tuy nhi\xEAn, Raze ng\xE0y c\xE0ng s\u1EE3 m\u1EA5t
    \u0111i v\u1ECB tr\xED m\xECnh \u0111\xE3 r\u1EA5t v\u1EA5t v\u1EA3 m\u1EDBi
    gi\xE0nh \u0111\u01B0\u1EE3c. Anh b\u1EAFt \u0111\u1EA7u th\xE1ch \u0111\u1EA5u
    v\xE0 \u0111u\u1ED5i \u0111i b\u1EA5t k\u1EF3 ai mu\u1ED1n b\u01B0\u1EDBc qua
    khu ph\u1ED1."
