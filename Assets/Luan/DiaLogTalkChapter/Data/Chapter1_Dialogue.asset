MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18f82e2ff20d89d40af9d8f994bac3f4, type: 3}
  m_Name: Chapter1_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::Luan.Dialogue.DialogueStoryData
  chapterTitle: 'Chapter 1: Concrete Dreams'
  lines:
  - speakerName: '{PLAYER}'
    side: 0
    text: "Khu ph\u1ED1 n\xE0y... \xE1nh \u0111\xE8n neon m\u1EDD \u1EA3o v\xE0 ti\u1EBFng
      bass d\u1ED9i l\xEAn t\u1EEB l\xF2ng \u0111\u1EA5t. \u0110\xE2y ch\xEDnh l\xE0
      Underground Arena."
    customAvatar: {fileID: 21300000, guid: ff10bfe60da849879042d61c0c0ccc3e, type: 3}
    nameColor: {r: 0.2, g: 0.95, b: 1, a: 1}
  - speakerName: BOSS 1
    side: 1
    text: "N\xE0y nh\xF3c! D\xE1m b\u01B0\u1EDBc ch\xE2n v\xE0o \u0111\u1ECBa b\xE0n
      c\u1EE7a ta th\xE1ch \u0111\u1EA5u \xE0? Nh\u1ECBp \u0111i\u1EC7u \u0111\u01B0\u1EDDng
      ph\u1ED1 \u1EDF \u0111\xE2y kh\xF4ng d\xE0nh cho k\u1EBB y\u1EBFu tim \u0111\xE2u!"
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.85, a: 1}
  - speakerName: '{PLAYER}'
    side: 0
    text: "T\xF4i \u0111\u1EBFn \u0111\xE2y kh\xF4ng ph\u1EA3i \u0111\u1EC3 d\u1EA1o
      ch\u01A1i. \xC2m nh\u1EA1c c\u1EE7a t\xF4i s\u1EBD khi\u1EBFn c\u1EA3 khu ph\u1ED1
      n\xE0y ph\u1EA3i th\u1EE9c t\u1EC9nh!"
    customAvatar: {fileID: 21300000, guid: ff10bfe60da849879042d61c0c0ccc3e, type: 3}
    nameColor: {r: 0.2, g: 0.95, b: 1, a: 1}
  - speakerName: BOSS 1
    side: 1
    text: "Hahaha! Kh\xE1 l\u1EAFm, {PLAYER}! Tr\xEAn s\xE0n \u0111\u1EA5u n\xE0y,
      ch\u1EC9 c\xF3 n\u1ED1t nh\u1EA1c chu\u1EA9n x\xE1c m\u1EDBi c\xF3 ti\u1EBFng
      n\xF3i. L\xCAN NH\u1EA0C \u0110I!"
    customAvatar: {fileID: 21300000, guid: 88c9d4bdaab44864a8c5e4337ec32c0c, type: 3}
    nameColor: {r: 1, g: 0.2, b: 0.85, a: 1}

